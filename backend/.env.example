# Copy to backend/.env and adjust. Every variable is optional; the values
# below are the defaults. Parsed and validated in src/config.ts.

PORT=3000
HOST=0.0.0.0

# Access-Control-Allow-Origin. Use * locally; set your web origin when deployed.
CORS_ORIGIN=*

# How many Audiveris runs may happen at once (each needs about 1-2 GB RAM).
RECOGNITION_CONCURRENCY=2
# How many jobs may wait for a free slot before uploads get 503 recognition_busy.
RECOGNITION_MAX_QUEUED_JOBS=20
# How long finished jobs and their MusicXML stay downloadable.
RECOGNITION_RETENTION_MINUTES=60

AUDIVERIS_IMAGE=drawliin/musical-ocr-audiveris:5.11.0
AUDIVERIS_TIMEOUT_SECONDS=120
