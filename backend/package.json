{
  "name": "@musical-ocr/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.2.1",
    "fflate": "^0.8.2",
    "jpeg-js": "^0.4.4",
    "multer": "^2.2.0",
    "pngjs": "^3.4.0"
  },
  "devDependencies": {
    "@musical-ocr/shared": "*",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
